# Obsidian MCP Configuration
# Copy this to .env and fill in your values for local development
# For Claude Desktop, credentials are passed via the config file

# Single vault mode
OBSIDIAN_VAULT_PATH=/path/to/your/vault
OBSIDIAN_VAULT_NAME=My Vault

# Multi-vault mode - JSON object of vault name -> path
# OBSIDIAN_VAULTS={"platform":"/path/to/platform","helena":"/path/to/helena"}

# Ollama configuration (for semantic search)
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Safety controls
# OBSIDIAN_READ_ONLY=true
# OBSIDIAN_WRAP_UNTRUSTED=true
# OBSIDIAN_AUTO_INDEX=false

# HTTP server mode (for testing/integration)
# OBSIDIAN_HTTP_SERVER=true
# OBSIDIAN_HTTP_PORT=3456
# OBSIDIAN_HTTP_TOKEN=replace-with-a-strong-secret
# OBSIDIAN_HTTP_CORS_ORIGIN=app://obsidian.md
